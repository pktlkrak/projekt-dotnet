{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ClinicManager;User Id=sa;Password=MySecurePassword123!;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "NLog": {
    "targets": {
      "file": {
      "type": "File",
        "fileName": "./logs/errors.log",
        "layout": "${longdate} | ${uppercase:${level:-padding:-5}} | ${message} ${exception:format=tostring}"
      },
      "console": {
        "type": "ColoredConsole",
        "layout": "${time} | ${uppercase:${level:-padding:-5}} | ${message} ${exception:format=tostring}"
    }
  },
  "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Trace", "writeTo": "file,console" }
    ]
  }
}
