@page
@model ClinicManager.Views.Procedures.IndexModel
@{
    ViewData["Title"] = "Procedures";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <h2 class="mb-0">Procedures</h2>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 text-muted text-uppercase small fw-semibold">Procedure Catalog</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Procedures.Any())
        {
            <p class="text-muted p-3 mb-0">No procedures defined yet.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Cost</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Procedures)
                    {
                        <tr>
                            <td class="align-middle fw-semibold">@p.Name</td>
                            <td class="align-middle text-muted">@p.Description</td>
                            <td class="align-middle text-end">@p.Cost.ToString("C")</td>
                            <td class="align-middle text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete @p.Name?')">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 text-muted text-uppercase small fw-semibold">Add Procedure</h6>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="NewProcedure.Name" class="form-label">Name</label>
                    <input asp-for="NewProcedure.Name" class="form-control" />
                    <span asp-validation-for="NewProcedure.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="NewProcedure.Description" class="form-label">Description</label>
                    <input asp-for="NewProcedure.Description" class="form-control" />
                    <span asp-validation-for="NewProcedure.Description" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="NewProcedure.Cost" class="form-label">Cost</label>
                    <input asp-for="NewProcedure.Cost" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="NewProcedure.Cost" class="text-danger small"></span>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Add</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
