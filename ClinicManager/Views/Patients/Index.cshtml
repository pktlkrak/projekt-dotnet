@page
@model ClinicManager.Views.Patients.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Lista Pacjentów</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p>
        <a asp-page="Create" class="btn btn-primary">Dodaj Pacjenta</a>
    </p>

    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="showDeletedToggle" 
               @(Model.ShowDeleted ? "checked" : "") 
               onchange="window.location.href='?ShowDeleted=' + this.checked">
        <label class="form-check-label" for="showDeletedToggle">
            Pokaż usuniętych pacjentów
        </label>
    </div>
</div>

@if (!Model.Patient.Any())
{
    <div class="alert alert-info">
        @if (Model.ShowDeleted)
        {
            <text>Brak usuniętych pacjentów.</text>
        }
        else
        {
            <text>Brak aktywnych pacjentów w systemie.</text>
        }
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].FirstName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].LastName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].Pesel)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].PhoneNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].DateOfBirth)
                </th>
                @if (Model.ShowDeleted)
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Patient[0].IsDeleted)
                    </th>
                }
                <th>
                    @Html.DisplayNameFor(model => model.Patient[0].InsuranceNumber)
                </th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.Patient) {
            <tr class="@(item.IsDeleted ? "table-danger" : "")">
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Pesel)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateOfBirth)
                </td>
                @if (Model.ShowDeleted)
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.IsDeleted)
                    </td>
                }
                <td>
                    @Html.DisplayFor(modelItem => item.InsuranceNumber)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                    @if (!item.IsDeleted)
                    {
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                    }
                </td>
            </tr>
    }
        </tbody>
    </table>
}
