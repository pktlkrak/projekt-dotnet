@page
@model ClinicManager.Views.Patients.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Patient</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.Pesel)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.Pesel)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.PhoneNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.DateOfBirth)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.DateOfBirth)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.IsDeleted)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.IsDeleted)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.InsuranceNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Patient.InsuranceNumber)
        </dd>
    </dl>
</div>
<div>
    <h4>Visits</h4>
    <hr />
    @if (!Model.Visits.Any())
    {
        <p class="text-muted">No visits recorded.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Visits)
                {
                    <tr>
                        <td class="align-middle">@v.ScheduledAt.ToString("g")</td>
                        <td class="align-middle">@v.Doctor?.LastName @v.Doctor?.FirstName</td>
                        <td class="align-middle">
                            <span class="badge @StatusBadge(v.Status)">@v.Status</span>
                        </td>
                        <td class="text-end align-middle">
                            <a asp-page="/Visits/Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Patient.Id" asp-route-returnUrl="@Url.Page("./Details", new { id = Model.Patient.Id, returnUrl = Model.ReturnUrl })">Edit</a> |
    <a href="@Model.ReturnUrl">Back to List</a>
    @if (!Model.Patient.IsDeleted)
    {
        <text> | </text>
        <form asp-page-handler="Delete" asp-route-id="@Model.Patient.Id" method="post" class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this patient?');">
            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit" class="btn btn-link p-0 align-baseline text-danger">Delete</button>
        </form>
    }
</div>

@functions {
    string StatusBadge(ClinicManager.Models.VisitStatus s) => s switch
    {
        ClinicManager.Models.VisitStatus.Scheduled  => "bg-primary",
        ClinicManager.Models.VisitStatus.InProgress => "bg-warning text-dark",
        ClinicManager.Models.VisitStatus.Finished   => "bg-success",
        ClinicManager.Models.VisitStatus.Cancelled  => "bg-secondary",
        _ => "bg-light text-dark"
    };
}
