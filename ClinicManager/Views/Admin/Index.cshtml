@page
@model ClinicManager.Views.Admin.AdminIndexModel
@{
    ViewData["Title"] = "User Management";
}

@if (TempData["StatusMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex gap-3" style="height: calc(100vh - 160px); min-height: 400px;">

    @* Users column *@
    <div class="d-flex flex-column flex-grow-1" style="min-width: 0;">
        <div class="card border-0 shadow-sm d-flex flex-column h-100 overflow-hidden">
            <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">User Management</h5>
                <a asp-page="/Admin/CreateUser" class="btn btn-primary btn-sm">+ Create User</a>
            </div>
            <div class="overflow-auto flex-grow-1">
                @if (Model.PendingUsers.Any())
                {
                    <div class="border-bottom border-warning">
                        <div class="px-3 py-2 bg-warning bg-opacity-25 d-flex align-items-center gap-2">
                            <span class="fw-semibold text-dark">Pending Approval</span>
                            <span class="badge bg-dark">@Model.PendingUsers.Count</span>
                        </div>
                        <table class="table table-hover mb-0">
                            <thead class="table-warning">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Requested role</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.PendingUsers)
                                {
                                    <tr>
                                        <td class="align-middle">@u.User.LastName @u.User.FirstName</td>
                                        <td class="align-middle text-muted small">@u.User.Email</td>
                                        <td class="align-middle">
                                            @foreach (var role in u.Roles)
                                            {
                                                <span class="badge @RoleBadge(role) me-1">@role</span>
                                            }
                                        </td>
                                        <td class="text-end align-middle">
                                            <div class="d-flex gap-1 justify-content-end">
                                                <form method="post" asp-page-handler="Approve" class="m-0">
                                                    <input type="hidden" name="userId" value="@u.User.Id" />
                                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                                </form>
                                                <form method="post" asp-page-handler="Reject" class="m-0"
                                                      onsubmit="return confirm('Reject and delete this registration?')">
                                                    <input type="hidden" name="userId" value="@u.User.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <table class="table table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role(s)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="align-middle">
                                    @if (string.IsNullOrWhiteSpace(u.User.FirstName + u.User.LastName))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        @u.User.LastName <text> </text> @u.User.FirstName
                                    }
                                </td>
                                <td class="align-middle text-muted small">@u.User.Email</td>
                                <td class="align-middle">
                                    @foreach (var role in u.Roles)
                                    {
                                        <span class="badge @RoleBadge(role) me-1">@role</span>
                                    }
                                </td>
                                <td class="text-end align-middle">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-page="/Admin/EditUser"
                                           asp-route-userId="@u.User.Id"
                                           class="btn btn-outline-secondary btn-sm">Edit</a>
                                        @if (!u.Roles.Contains("Admin"))
                                        {
                                            <form method="post" asp-page="/Admin/Impersonate" asp-page-handler="Start" class="m-0">
                                                <input type="hidden" name="userId" value="@u.User.Id" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm">Switch view</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Medications column *@
    @await Html.PartialAsync("_MedicationsList", (Model.Medications, "/Admin/Index"))

</div>

@functions {
    string RoleBadge(string role) => role switch
    {
        "Admin"              => "bg-danger",
        "Doctor"             => "bg-success",
        "RegistrationWorker" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
