@page
@model ClinicManager.Pages.Debug.Test.EmailModel
@{
    ViewData["Title"] = "Test Email";
}

<h2 class="mb-4">Test Email</h2>

@if (Model.Message != null)
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

<div class="col-md-6">
    <form method="post">
        <div class="mb-3">
            <label asp-for="To" class="form-label">To</label>
            <input asp-for="To" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Subject" class="form-label">Subject</label>
            <input asp-for="Subject" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Body" class="form-label">Body</label>
            <textarea asp-for="Body" class="form-control" rows="5"></textarea>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="IsHtml" class="form-check-input" type="checkbox" />
            <label asp-for="IsHtml" class="form-check-label">HTML body</label>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
</div>
