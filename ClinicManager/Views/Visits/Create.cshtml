@page
@model ClinicManager.Views.Visits.CreateModel
@{
    ViewData["Title"] = "Schedule Appointment";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">← Back</a>
    <h2 class="mb-0">Schedule Appointment</h2>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Visit.PatientId" class="form-label">Patient</label>
                        <select asp-for="Visit.PatientId" asp-items="Model.PatientItems" class="form-select">
                            <option value="">— select patient —</option>
                        </select>
                        <span asp-validation-for="Visit.PatientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Visit.DoctorId" class="form-label">Doctor</label>
                        <select asp-for="Visit.DoctorId" asp-items="Model.DoctorItems" class="form-select">
                            <option value="">— select doctor —</option>
                        </select>
                        <span asp-validation-for="Visit.DoctorId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Visit.ProcedureId" class="form-label">Procedure</label>
                            <select asp-for="Visit.ProcedureId" asp-items="Model.ProcedureItems" class="form-select" id="procedure-select">
                                <option value="">— select procedure —</option>
                            </select>
                            <span asp-validation-for="Visit.ProcedureId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Visit.Cost" class="form-label">Cost (PLN)</label>
                            <input asp-for="Visit.Cost" type="number" step="0.01" min="0" class="form-control" id="procedure-cost" />
                            <span asp-validation-for="Visit.Cost" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Visit.ScheduledAt" class="form-label">Date &amp; Time</label>
                        <input asp-for="Visit.ScheduledAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Visit.ScheduledAt" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Visit.Status" class="form-label">Status</label>
                        <select asp-for="Visit.Status" asp-items="Html.GetEnumSelectList<ClinicManager.Models.VisitStatus>()" class="form-select"></select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Schedule</button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @using System.Text.Json
    <script>
        const procedureCosts = @Html.Raw(JsonSerializer.Serialize(Model.ProcedureCosts));
        document.getElementById('procedure-select').addEventListener('change', function () {
            const id = parseInt(this.value);
            const costInput = document.getElementById('procedure-cost');
            if (procedureCosts[id] !== undefined) costInput.value = procedureCosts[id].toFixed(2);
        });
    </script>
}
